{
  "enabled": true,
  "type": "ext",
  "plugin": "",
  "min_interval_min": 10,
  "jitter_pct": 30,
  "daily_limit": 60,
  "max_photos": 10,
  "title_spaces": 0,
  "confirm_before_publish": false,
  "scenarios": {
    "default": [
      {
        "action": "goto",
        "label": "открыть сайт",
        "url": "https://www.vatera.hu/"
      },
      {
        "action": "click",
        "label": "HIRDETÉSFELADÁS",
        "selectors": [
          "a:has-text(\"HIRDETÉSFELADÁS\")",
          "text=\"HIRDETÉSFELADÁS\"",
          "#logo_wrapp > div > div > div:nth-of-type(2) > div > div:nth-of-type(2) > a"
        ]
      },
      {
        "action": "fill",
        "label": "Название",
        "selectors": [
          "#de59-product_title",
          "input[name=\"product_title\"]"
        ],
        "value": "{title}"
      },
      {
        "action": "fill",
        "label": "Описание",
        "selectors": [
          "#tinymce",
          "body[aria-label=\"Vizuális\\ szerkesztő\\ terület\\.\\ Nyomjon\\ ALT-0-t\\ a\\ súgóhoz\\.\"]"
        ],
        "value": "{body}"
      },
      {
        "action": "upload",
        "label": "фото",
        "multiple": true,
        "selectors": [
          "div:has-text(\"Kép feltöltése (max. 12 db)\")",
          "text=\"Kép feltöltése (max. 12 db)\"",
          "#de59 > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > fieldset:nth-of-type(1) > div:nth-of-type(2) > section > div",
          "div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > fieldset:nth-of-type(1) > div:nth-of-type(2) > section > div > input"
        ]
      },
      {
        "action": "fill",
        "label": "Цена",
        "selectors": [
          "#de59-product_start_price",
          "input[name=\"product_start_price\"]"
        ],
        "value": "{price}"
      },
      {
        "action": "choose",
        "name": "state_flag",
        "prefer": [
          "Új"
        ],
        "exact": true,
        "label": "Состояние → Új (новый)"
      },
      {
        "action": "choose",
        "name": "recommended-category",
        "prefer": [
          "Táskák",
          "táska"
        ],
        "label": "Категория (из предложенных Vatera, с «Táskák»)"
      },
      {
        "action": "choose",
        "group": "Kinek",
        "prefer": [
          "uniszex"
        ],
        "exact": true,
        "ifPresent": true,
        "timeout": 8000,
        "label": "Kinek → uniszex (для кого)"
      },
      {
        "action": "click",
        "label": "Tovább",
        "selectors": [
          "button:has-text(\"Tovább\")",
          "text=\"Tovább\"",
          "#de59 > div:nth-of-type(2) > div > div > div:nth-of-type(3) > button"
        ]
      },
      {
        "action": "click",
        "label": "Tovább",
        "selectors": [
          "#nextbutton"
        ]
      },
      {
        "action": "click",
        "label": "TOVÁBB ➔",
        "selectors": [
          "#save_button"
        ]
      }
    ],
    "bags": [
