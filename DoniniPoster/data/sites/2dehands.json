{
  "enabled": false,
  "type": "ext",
  "plugin": "",
  "min_interval_min": 10,
  "jitter_pct": 30,
  "daily_limit": 60,
  "max_photos": 10,
  "title_spaces": 0,
  "confirm_before_publish": false,
  "scenarios": {
    "bags": [
      {
        "action": "goto",
        "label": "открыть сайт",
        "url": "https://www.2dehands.be/"
      },
      {
        "action": "click",
        "label": "Plaats zoekertje",
        "selectors": [
          "a[aria-label=\"Plaats\\ zoekertje\"]",
          "a:has-text(\"Plaats zoekertje\")",
          "text=\"Plaats zoekertje\"",
          "#header-root > header > div > div:nth-of-type(2) > div > ul:nth-of-type(2) > li:nth-of-type(5) > a"
        ]
      },
      {
        "action": "fill",
        "label": "Название",
        "selectors": [
          "#TextField-vulEenTitelIn",
          "input[name=\"keywords\"]"
        ],
        "value": "{title}"
      },
      {
        "action": "click",
        "label": "Vind categorie",
        "selectors": [
          "[data-testid=\"findCategory\"]",
          "button:has-text(\"Vind categorie\")",
          "text=\"Vind categorie\"",
          "div > div > div > div > form:nth-of-type(1) > div > div:nth-of-type(2) > button"
        ]
      },
      {
        "action": "click",
        "label": "Verder",
        "selectors": [
          "[data-testid=\"redirectToPlaceAd\"]",
          "button:has-text(\"Verder\")",
          "text=\"Verder\""
        ]
      },
      {
        "action": "upload",
        "label": "фото",
        "multiple": true,
        "selectors": [
          "#imageUploader-hiddenInput",
          "input[type=\"file\"]"
        ]
      },
      {
        "action": "fill",
        "label": "Описание",
        "selectors": [
          "[data-testid=\"text-editor-input_nl-BE\"]",
          "#syi-form > div:nth-of-type(3) > div:nth-of-type(2) > div:nth-of-type(2) > div > div > div > div:nth-of-type(2)"
        ],
        "value": "{body}"
      },
      {
        "action": "select",
        "label": "Nieuw",
        "selectors": [
          "#singleSelectAttribute\\[condition\\]",
          "select[name=\"singleSelectAttribute\\[condition\\]\"]"
        ],
        "value": "Nieuw"
      },
      {
        "action": "check",
        "alt": [
          "label:has-text(\"Bpost 2 - 5 kg\")",
          "text=\"Bpost 2 - 5 kg\"",
          "#packageSizeRadioGroup > div > div:nth-of-type(2) > label"
        ],
        "label": "Bpost 2 - 5 kg",
        "selectors": [
          "#Radio-bpost-25Kg",
          "input[name=\"packageSize\"]"
        ],
        "value": true
      },
      {
        "action": "check",
        "alt": [
          "[data-testid=\"syi-bidding-switch\"]",
          "#syi-bidding-switch",
          "label:has-text(\"Bieden toestaan\")",
          "text=\"Bieden toestaan\""
        ],
        "label": "Bieden toestaan",
        "selectors": [
          "#syi-bidding-switch-input"
        ],
        "value": false
      },
      {
        "action": "fill",
        "label": "Цена",
        "selectors": [
          "#price\\.value",
          "input[name=\"price\\.value\"]",
          "input[placeholder=\"\\30 \\,00\"]"
        ],
        "value": "{price}"
      },
      {
        "action": "fill",
        "label": "свой текст",
        "selectors": [
          "[data-testid=\"syi-postcode-input\"]",
          "#postCode",
          "input[name=\"contactInformation\\.postCode\"]",
          "input[placeholder=\"\\31 234\"]"
        ],
        "value": "2000"
      },
      {
        "action": "check",
        "alt": [
          "[data-testid=\"bundle-option-FREE\"]",
          "label:has-text(\"Gratis\")",
          "div:nth-of-type(2) > div:nth-of-type(2) > div > div > div > div > fieldset > label:nth-of-type(1)"
        ],
        "label": "Gratis € 0,00 Standaard zichtbaarheid 4 weken zichtbaar op 2",
        "selectors": [
          "#feature-FREE",
          "input[name=\"bundle-selection\"]"
        ],
        "value": true
      },
      {
        "action": "publish",
        "label": "Plaats je zoekertje",
        "selectors": [
          "[data-testid=\"place-listing-submit-button\"]",
          "button:has-text(\"Plaats je zoekertje\")",
          "text=\"Plaats je zoekertje\"",
          "#syi-form > div:nth-of-type(11) > div > div > div:nth-of-type(2) > button:nth-of-type(2)"
        ]
      }
    ]
  },
  "id": "2dehands",
  "name": "2dehands.be",
  "lang": "BE",
  "start_url": "https://www.2dehands.be/"
}