{
  "enabled": false,
  "type": "ext",
  "plugin": "",
  "min_interval_min": 10,
  "jitter_pct": 30,
  "daily_limit": 60,
  "max_photos": 10,
  "title_spaces": 0,
  "confirm_before_publish": false,
  "scenarios": {
    "bags": [
      {
        "action": "goto",
        "label": "открыть сайт",
        "url": "https://vendora.gr/"
      },
      {
        "action": "click",
        "label": "Πούλα κάτι",
        "selectors": [
          "a:has-text(\"Πούλα κάτι\")",
          "text=\"Πούλα κάτι\"",
          "html > body > header > div > ul > li:nth-of-type(3) > a"
        ]
      },
      {
        "action": "fill",
        "label": "Название",
        "selectors": [
          "#title-field-container > input"
        ],
        "value": "{title}"
      },
      {
        "action": "upload",
        "label": "фото",
        "multiple": true,
        "selectors": [
          "#images-field-container input[type=\"file\"]",
          "#images-field-container > div > div:nth-of-type(1) > div > div > div > div > input"
        ]
      },
      {
        "action": "click",
        "label": "-",
        "selectors": [
          "#vs7__combobox > div:nth-of-type(1) > div",
          "#vs7__combobox"
        ]
      },
      {
        "action": "click",
        "label": "Καινούργιο Καινούργιο, αχρησιμοποίητο αντικείμενο με ετικέτε",
        "selectors": [
          "#vs7__option-1",
          "li:has-text(\"Καινούργιο\")"
        ]
      },
      {
        "action": "fill",
        "label": "Описание",
        "selectors": [
          "#description-field-container > textarea"
        ],
        "value": "{body}"
      },
      {
        "action": "fill",
        "label": "Цена",
        "selectors": [
          "#price"
        ],
        "value": "{price}"
      },
      {
        "action": "click",
        "label": "вес",
        "selectors": [
          "#vs2__combobox > div:nth-of-type(1) > input",
          "#vs2__combobox"
        ]
      },
      {
        "action": "click",
        "label": "από 1 ως 2 κιλά",
        "selectors": [
          "#vs2__option-2",
          "li:has-text(\"από 1 ως 2 κιλά\")",
          "text=\"από 1 ως 2 κιλά\""
        ]
      },
      {
        "action": "click",
        "label": "размер коробки",
        "selectors": [
          "#vs3__combobox > div:nth-of-type(1) > input",
          "#vs3__combobox"
        ]
      },
      {
        "action": "click",
        "label": "Μεγαλύτερο κουτί Μέγιστο 36 × 45 × 60 εκ. Μπουφάν · Είδη κου",
        "selectors": [
          "#vs3__option-2",
          "li:has-text(\"Μεγαλύτερο κουτί\")"
        ]
      },
      {
        "action": "publish",
        "label": "Καταχώρισε την αγγελία",
        "selectors": [
          "#item-submit-button",
          "button:has-text(\"Καταχώρισε την αγγελία\")",
          "text=\"Καταχώρισε την αγγελία\""
        ]
      }
    ]
  },
  "id": "vendora",
  "name": "Vendora.gr",
  "lang": "GR",
  "start_url": "https://vendora.gr/"
}