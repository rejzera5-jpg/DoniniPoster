{
  "enabled": true,
  "type": "ext",
  "plugin": "",
  "min_interval_min": 10,
  "jitter_pct": 30,
  "daily_limit": 60,
  "max_photos": 12,
  "title_spaces": 0,
  "confirm_before_publish": false,
  "scenarios": {
    "default": [
      {
        "action": "goto",
        "label": "открыть сайт",
        "url": "https://www.jofogas.hu/"
      },
      {
        "action": "click",
        "label": "Hirdetésfeladás",
        "selectors": [
          "a[aria-label=\"Hirdetésfeladás\"]",
          "a:has-text(\"Hirdetésfeladás\")",
          "text=\"Hirdetésfeladás\"",
          "#app-bar-header > div > div > div > div > a"
        ]
      },
      {
        "action": "fill",
        "label": "Название",
        "selectors": [
          "[data-test=\"ai-subject\"]",
          "#hf_subject",
          "input[name=\"subject\"]"
        ],
        "value": "{title}"
      },
      {
        "action": "upload",
        "label": "фото",
        "multiple": true,
        "selectors": [
          "label:has-text(\"Húzd ide a képeket\")",
          "text=\"Húzd ide a képeket\"",
          "#image-uploader-wrapper > label",
          "[data-test=\"upload-image-button\"]",
          "#upload-image"
        ],
        "waitUpload": true
      },
      {
        "action": "click",
        "label": "Tovább",
        "selectors": [
          "[data-test=\"ai-next-2\"]",
          "button:has-text(\"Tovább\")",
          "text=\"Tovább\"",
          "#hirdetesfeladas > div > div > button"
        ]
      },
      {
        "action": "click",
        "label": "Kiválasztom",
        "selectors": [
          "button:has-text(\"Kiválasztom\")",
          "text=\"Kiválasztom\"",
          "div:nth-of-type(1) > div:nth-of-type(2) > div > div:nth-of-type(1) > div > div > div:nth-of-type(2) > button"
        ],
        "optional": true,
        "timeout": 20000
      },
      {
        "action": "selectText",
        "label": "категория (если сайт не предложил)",
        "selectors": [
          "#hirdetesfeladas select",
          "form select"
        ],
        "index": 0,
        "text": "Divat, ruházat",
        "optional": true,
        "onlyIfEmpty": true,
        "timeout": 3000
      },
      {
        "action": "selectText",
        "label": "подкатегория",
        "selectors": [
          "#hirdetesfeladas select",
          "form select"
        ],
        "index": 1,
        "text": "Férfi ruházat és kiegészítők",
        "optional": true,
        "onlyIfEmpty": true,
        "timeout": 3000
      },
      {
        "action": "selectText",
        "label": "раздел",
        "selectors": [
          "#hirdetesfeladas select",
          "form select"
        ],
        "index": 2,
        "text": "Táskák, bőröndök",
        "optional": true,
        "onlyIfEmpty": true,
        "timeout": 3000
      },
      {
        "action": "selectText",
        "label": "Kínál (продаю)",
        "selectors": [
          "#hirdetesfeladas select",
