{
  "enabled": true,
  "type": "ext",
  "plugin": "",
  "min_interval_min": 2,
  "jitter_pct": 30,
  "daily_limit": 10000,
  "max_photos": 10,
  "title_spaces": 0,
  "confirm_before_publish": false,
  "scenarios": {
    "bags": [
      {
        "action": "goto",
        "label": "открыть сайт",
        "url": "https://www.publi24.ro/"
      },
      {
        "action": "click",
        "label": "Adaugă anunț",
        "selectors": [
          "a:has-text(\"Adaugă anunț\")",
          "text=\"Adaugă anunț\"",
          "#header > div > div > div > a:nth-of-type(2)"
        ]
      },
      {
        "action": "upload",
        "label": "фото",
        "multiple": true,
        "selectors": [
          "#fileUpload",
          "input[type=\"file\"]"
        ]
      },
      {
        "action": "fill",
        "label": "Название",
        "selectors": [
          "#Title",
          "input[name=\"Title\"]"
        ],
        "value": "{title}"
      },
      {
        "action": "click",
        "label": "Alege o categorie",
        "selectors": [
          "a:has-text(\"Alege o categorie\")",
          "text=\"Alege o categorie\"",
          "#modifyCategory > div:nth-of-type(2) > a"
        ]
      },
      {
        "action": "click",
        "label": "Moda si accesorii / Accesorii",
        "selectors": [
          "a:has-text(\"Moda si accesorii / Accesorii\")",
          "text=\"Moda si accesorii / Accesorii\"",
          "#recommendedCateg > li:nth-of-type(1) > a"
        ]
      },
      {
        "action": "fill",
        "label": "Описание",
        "selectors": [
          "#Description",
          "textarea[name=\"Description\"]"
        ],
        "value": "{body}"
      },
      {
        "action": "check",
        "alt": [
          "label:has-text(\"Livrare cu verificare colet\")",
          "#PlaceAdFormDetails > div:nth-of-type(1) > div:nth-of-type(2) > label"
        ],
        "label": "Livrare cu verificare colet Doresc sa ofer serviciul \"Livrar",
        "selectors": [
          "input[name=\"ArticleWithDelivery\"]",
          "#PlaceAdFormDetails > div:nth-of-type(1) > div:nth-of-type(2) > label > input"
        ],
        "value": true
      },
      {
        "action": "select",
        "label": "nou",
        "selectors": [
          "#Prop_status",
          "select[name=\"Properties\\[status\\]\"]"
        ],
        "value": "nou"
      },
      {
        "action": "fill",
        "label": "Цена",
        "selectors": [
          "#Price",
          "input[name=\"PriceVar\"]"
        ],
        "value": "{price}"
      },
      {
        "action": "select",
        "label": "Валюта EUR",
        "selectors": [
          "#Currency",
          "select[name=\"Currency\"]"
        ],
        "value": "EUR"
      },
      {
        "action": "check",
        "alt": [
          "label:has-text(\"Da Nu\")",
          "text=\"Da Nu\"",
          "#priceSection > div > div:nth-of-type(2) > div > div:nth-of-type(3) > div > label"
        ],
        "label": "Da Nu",
        "selectors": [
          "#PriceNegociable"
        ],
        "value": true
      },
      {
        "action": "click",
        "label": "Publica anuntul",
        "selectors": [
          "#save-article-btn",
          "button:has-text(\"Publica anuntul\")",
          "text=\"Publica anuntul\""
        ]
      },
      {
        "action": "publish",
        "label": "Continuă fără promovare",
        "selectors": [
          "#freeBtn",
          "a:has-text(\"Continuă fără promovare\")",
          "text=\"Continuă fără promovare\""
        ]
      }
    ]
  },
  "id": "publi24",
  "name": "Publi24.ro",
  "lang": "RO",
  "start_url": "https://www.publi24.ro/",
  "title_brand": true,
  "currency": "EUR"
}