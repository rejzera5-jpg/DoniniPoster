{
  "enabled": false,
  "type": "ext",
  "plugin": "",
  "min_interval_min": 10,
  "jitter_pct": 30,
  "daily_limit": 60,
  "max_photos": 10,
  "title_spaces": 0,
  "confirm_before_publish": false,
  "scenarios": {
    "default": [
      {
        "action": "goto",
        "label": "открыть сайт",
        "url": "https://www.marktplaats.nl/"
      },
      {
        "action": "click",
        "label": "Plaats advertentie",
        "selectors": [
          "a[aria-label=\"Plaats\\ advertentie\"]",
          "a:has-text(\"Plaats advertentie\")",
          "text=\"Plaats advertentie\"",
          "#header-root > header > div > div:nth-of-type(2) > div > ul:nth-of-type(2) > li:nth-of-type(5) > a"
        ]
      },
      {
        "action": "fill",
        "label": "Название",
        "selectors": [
          "#TextField-vulEenTitelIn",
          "input[name=\"keywords\"]"
        ],
        "value": "{title}"
      },
      {
        "action": "click",
        "label": "Vind categorie",
        "selectors": [
          "[data-testid=\"findCategory\"]",
          "button:has-text(\"Vind categorie\")",
          "text=\"Vind categorie\"",
          "div > div > div > div > form:nth-of-type(1) > div > div:nth-of-type(2) > button:nth-of-type(1)"
        ]
      },
      {
        "action": "click",
        "label": "Verder",
        "selectors": [
          "[data-testid=\"redirectToPlaceAd\"]",
          "button:has-text(\"Verder\")",
          "text=\"Verder\"",
          "#root > div > div > div > div > div > button"
        ]
      },
      {
        "action": "upload",
        "label": "фото",
        "multiple": true,
        "selectors": [
          "[data-testid=\"image-uploader-box-label\"]",
          "label[aria-label=\"Afbeelding\\ toevoegen\"]",
          "label:has-text(\"Voeg foto’s toe\")",
          "text=\"Voeg foto’s toe\"",
          "#photo-upload > div:nth-of-type(2) > div > div:nth-of-type(1) > div > ul > li:nth-of-type(1) > label",
          "#imageUploader-hiddenInput"
        ]
      },
      {
        "action": "fill",
        "label": "Описание",
        "selectors": [
          "[data-testid=\"text-editor-input_nl-NL\"]",
          "#syi-form > div:nth-of-type(3) > div:nth-of-type(2) > div:nth-of-type(3) > div > div > div > div:nth-of-type(2)"
        ],
        "value": "{body}"
      },
      {
        "action": "fill",
        "label": "Цена",
        "selectors": [
          "#price\\.value",
          "input[name=\"price\\.value\"]",
          "input[placeholder=\"\\30 \\,00\"]"
        ],
        "value": "{price}"
      },
      {
        "action": "click",
        "label": "FREE",
        "selectors": [
          "#feature-FREE",
          "input[name=\"bundle-selection\"]"
        ]
      },
      {
        "action": "click",
        "label": "Plaats je advertentie",
        "selectors": [
          "[data-testid=\"place-listing-submit-button\"]",
          "button:has-text(\"Plaats je advertentie\")",
          "text=\"Plaats je advertentie\"",
          "#syi-form > div:nth-of-type(11) > div > div > div:nth-of-type(2) > button:nth-of-type(2)"
        ]
      }
    ],
    "other": [
